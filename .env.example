PORT=8787
RENAMER_TOKEN=replace-with-a-long-random-token
COMMAND_TIMEOUT_MS=15000
ARCHIVE_DIR=./data
# Scheduled incremental backup (0 = off). Each run fetches only new/changed chats.
SYNC_INTERVAL_MINUTES=360
# Run when no chatgpt.com tab is connected at sync time (WSL example opens Chrome):
SYNC_OPEN_CHATGPT_CMD=cd /mnt/c && cmd.exe /c start "" chrome https://chatgpt.com
