PORT=8787
# 127.0.0.1 keeps the broker reachable only from this computer (default).
HOST=127.0.0.1
RENAMER_TOKEN=replace-with-a-long-random-token
COMMAND_TIMEOUT_MS=15000
ARCHIVE_DIR=./data
# Scheduled backup of your chats into data/ (0 = off). The first run downloads
# every chat (hours) and shares the ChatGPT rate limit with ask_chatgpt; later
# runs fetch only new/changed chats. e.g. 360 = every 6 hours.
SYNC_INTERVAL_MINUTES=0
# Email or user id for the ChatGPT account whose conversations bulk sync stores.
# Required when multiple accounts or unidentified tabs are connected.
SYNC_ACCOUNT=
# Shell command that opens https://chatgpt.com in the Chrome profile running the
# extension. Backup runs it when no chatgpt.com tab is connected, and
# ask_chatgpt runs it with the URL swapped for https://chatgpt.com/?ccm_agent=1
# to open an agent tab. Leave unset to open those tabs yourself.
#   macOS:  SYNC_OPEN_CHATGPT_CMD='open -a "Google Chrome" https://chatgpt.com'
#   Linux:  SYNC_OPEN_CHATGPT_CMD='google-chrome https://chatgpt.com'
#   WSL:    SYNC_OPEN_CHATGPT_CMD='cd /mnt/c && cmd.exe /c start "" chrome https://chatgpt.com'
